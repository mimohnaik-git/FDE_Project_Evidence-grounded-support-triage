# Copy to .env, then supply only the credentials you need.
# Keys can also be entered in the Streamlit sidebar for the current session.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
# Chat options: auto, openai, anthropic, ollama
LLM_PROVIDER=auto
LLM_MODEL=
OLLAMA_BASE_URL=http://localhost:11434
# Embeddings: auto, openai, local. Local needs one initial model download.
EMBEDDING_PROVIDER=local
