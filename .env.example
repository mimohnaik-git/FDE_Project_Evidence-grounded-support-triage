# Copy this file to .env and fill in whichever provider you're using:
#   cp .env.example .env
#
# You only need ONE chat provider — the app auto-detects which one is set
# (OpenAI first, then Anthropic, then a local Ollama server) unless you
# pin one explicitly with LLM_PROVIDER below. You can also just paste a
# key into the sidebar at runtime instead of editing this file.

# Option A — OpenAI (paid, default model: gpt-4o-mini)
# Also used for knowledge-base embeddings if EMBEDDING_PROVIDER is left on
# "auto" (or set to "openai") and this key is present.
OPENAI_API_KEY=sk-...

# Option B — Anthropic (paid, default model: claude-haiku-4-5)
# ANTHROPIC_API_KEY=sk-ant-...

# Option C — Ollama (free, fully local, default model: llama3.1)
# No key needed. Install from https://ollama.com, run `ollama serve`,
# then `ollama pull llama3.1`. Uncomment this only if Ollama runs
# somewhere other than the default http://localhost:11434.
# OLLAMA_BASE_URL=http://localhost:11434

# Optional: force a specific chat provider instead of auto-detecting.
# LLM_PROVIDER=openai   # openai | anthropic | ollama | auto (default)

# Optional: override the default chat model for whichever provider is active.
# LLM_MODEL=gpt-4o

# Optional: choose the knowledge-base embedding provider.
#   auto (default) -> OpenAI if OPENAI_API_KEY is set, else the free local model
#   openai         -> text-embedding-3-small (paid, needs OPENAI_API_KEY)
#   local          -> all-MiniLM-L6-v2, runs on-device, no key or cost
# EMBEDDING_PROVIDER=auto
